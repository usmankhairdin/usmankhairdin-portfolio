<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the existing www canonical host consistent for all first-party URLs.
  RewriteCond %{HTTP_HOST} ^usmankhairdin\.com$ [NC]
  RewriteRule ^ https://www.usmankhairdin.com%{REQUEST_URI} [R=301,L,NE]

  # Preserve real files and folders already on the host (including /portfolio/).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Each public React route has a generated index.html. Unknown URLs must be
  # real 404s, not a soft-404 copy of the homepage.
  RewriteRule . - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
