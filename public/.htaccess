<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the existing www canonical host consistent for all first-party URLs.
  RewriteCond %{HTTP_HOST} ^usmankhairdin\.com$ [NC]
  RewriteRule ^ https://www.usmankhairdin.com%{REQUEST_URI} [R=301,L,NE]

  # The Web Experience homepage moved from /home-classic/ to /web/.
  RewriteRule ^home-classic/?$ /web/ [R=301,L]

  # Retired client showcases now lead to the independent project collection.
  # Run before the file check so old deployed HTML cannot remain visible.
  RewriteRule ^work/(prima|rantle|bum-life|basecare|base-care|bascare)(/.*)?$ /work/ [R=301,L,NC]
  RewriteRule ^portfolio/(bum\.life|prima|rantle|basecare|base-care|bascare)(/.*)?$ /work/ [R=301,L,NC]

  # Preserve real files and folders already on the host (including /portfolio/).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Each public React route has a generated index.html. Unknown URLs must be
  # real 404s, not a soft-404 copy of the homepage.
  RewriteRule . - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compress text and geometry on hosts that provide mod_deflate. Image formats
# are already compressed; leave those bytes unchanged.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml model/gltf+json model/gltf-binary application/octet-stream
</IfModule>

# Only Vite's content-hashed JS/CSS are immutable. Revalidate ordinary assets
# so updated GLTF manifests, binaries and captures cannot disagree after upload.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|gltf|glb|bin)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
